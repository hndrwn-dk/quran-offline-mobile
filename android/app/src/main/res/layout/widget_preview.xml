<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): the medium layout with QS 94:5.
     The Arabic is a QPC V2 render (tools/widget_ayah_preview_render_test.dart). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_reflection_label"
        android:textColor="@color/widget_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_ayah"
        android:tint="@color/widget_ink" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/widget_preview_translation"
        android:textColor="@color/widget_ink"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_preview_ref"
        android:textColor="@color/widget_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
