<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable 2x1 (continue) .. 4x2 (ayah) .. 4x3+ (reflection + actions).
     Content refreshes from Flutter and a daily WorkManager job, so no updatePeriod. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview"
    android:previewImage="@drawable/widget_preview_image"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_beranda_description" />
